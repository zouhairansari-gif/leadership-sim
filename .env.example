ANTHROPIC_API_KEY=sk-ant-...
ACTOR_MODEL=claude-sonnet-5
EVALUATOR_MODEL=claude-sonnet-5
EVALUATOR_PASSES=3

# Optional. If unset, the app runs with no password gate at all (fine for
# local development). Set this before deploying anywhere reachable by
# other people. On Streamlit Community Cloud, set it via the app's
# Settings -> Secrets panel, not this file — this file is for local use.
APP_PASSWORD=choose-something-here
